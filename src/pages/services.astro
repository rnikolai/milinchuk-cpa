---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services | Milinchuk CPA Professional Corporation" description="Accounting, tax preparation, bookkeeping, corporate returns, and financial advisory services for individuals and businesses in Toronto, Ontario.">
  <section class="hero-wrap hero-wrap-2" style="background-image: url('images/bg_2.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
      <div class="row no-gutters slider-text align-items-end">
        <div class="col-md-9 ftco-animate pb-5">
          <h1 class="mb-0 bread">Services</h1>
        </div>
      </div>
    </div>
  </section>

  <section class="ftco-section ftco-no-pt bg-light">
    <div class="container">
      <div class="row d-flex no-gutters">
        <div class="col-md-6 d-flex">
          <div class="img img-video d-flex align-self-stretch align-items-center justify-content-center justify-content-md-center mb-4 mb-sm-0" style="background-image:url(images/about.jpg);"></div>
        </div>
        <div class="col-md-6 pl-md-5 py-md-5">
          <div class="heading-section pl-md-4 pt-md-5">
            <span class="subheading">Welcome to Milinchuk CPA</span>
            <h2 class="mb-4">What's Included</h2>
          </div>
          <div class="services-2 w-100 d-flex">
            <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-wealth"></span></div>
            <div class="text pl-4">
              <h4>Accounting &amp; Bookkeeping</h4>
              <p>Full Cycle Accounting | General Ledger and Trial Balance Maintenance | Reconciliations &amp; Financial Cleanups</p>
            </div>
          </div>
          <div class="services-2 w-100 d-flex">
            <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-accountant"></span></div>
            <div class="text pl-4">
              <h4>Personal &amp; Corporate Tax</h4>
              <p>Personal Tax T1 | Corporate Tax T2 | CRA Compliance | HST Reports</p>
            </div>
          </div>
          <div class="services-2 w-100 d-flex">
            <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-teamwork"></span></div>
            <div class="text pl-4">
              <h4>Financial Reporting</h4>
              <p>Financial Documents Preparation | Balance sheets, I/S &amp; Cash Flow Analysis | Key Performance Indicators (KPIs) tailored to your goals</p>
            </div>
          </div>
          <div class="services-2 w-100 d-flex">
            <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-accounting"></span></div>
            <div class="text pl-4">
              <h4>Management Consulting &amp; Advisory</h4>
              <p>Identify Operational Inefficiencies | Recommend Cost-Saving Solutions | New Technology Implementation &amp; Switch (Quickbooks, Xero, Wave) | Implement and Strengthen Internal Controls | Support Business Expansion, Restructuring, &amp; Risk Mitigation | Business Loans &amp; Grants Applications</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="row justify-content-center pb-5 mb-3">
    <div class="col-md-7 heading-section heading-section-white text-center ftco-animate">
      <span class="subheading">Our working process</span>
      <h2>How Milinchuk CPA Professional Corporation Works For You:</h2>
      <span class="subheading">At Milinchuk CPA, we believe in building strong relationships from day one. Our onboarding &amp; discovery call is the first step in understanding your business needs and financial goals.</span>
      <span class="subheading">During this call, we'll:</span>
    </div>
  </div>

  <section class="ftco-section bg-light ftco-no-pt">
    <div class="container">
      <div class="row">
        <div class="col-md-6 col-lg-3 d-flex services align-self-stretch px-4 ftco-animate">
          <div class="d-block">
            <div class="icon d-flex mr-2"><span class="flaticon-accounting-1"></span></div>
            <div class="media-body">
              <h3 class="heading">Step 1</h3>
              <p>Learn about your business operations and challenges.</p>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 d-flex services align-self-stretch px-4 ftco-animate">
          <div class="d-block">
            <div class="icon d-flex mr-2"><span class="flaticon-tax"></span></div>
            <div class="media-body">
              <h3 class="heading">Step 2</h3>
              <p>Discuss your accounting, bookkeeping, and tax requirements.</p>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 d-flex services align-self-stretch px-4 ftco-animate">
          <div class="d-block">
            <div class="icon d-flex mr-2"><span class="flaticon-loan"></span></div>
            <div class="media-body">
              <h3 class="heading">Step 3</h3>
              <p>Identify opportunities for financial optimization.</p>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 d-flex services align-self-stretch px-4 ftco-animate">
          <div class="d-block">
            <div class="icon d-flex mr-2"><span class="flaticon-budget"></span></div>
            <div class="media-body">
              <h3 class="heading">Step 4</h3>
              <p>Answer any questions you have about our services.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
